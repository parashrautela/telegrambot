# Create two bots with @BotFather. Never commit the real tokens.
LEADER_BOT_TOKEN=
GROUP_BOT_TOKEN=

# Google Cloud service-account credentials. Share the target spreadsheet with this email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the value on one line and use literal \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram numeric user ID for Parash/the founder. This account has global admin access.
FOUNDER_TELEGRAM_ID=

# Optional intelligence layer. Add a newly created OpenAI API key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Connect pending requests to the workflow web app.
WEB_APP_URL=
INTEGRATION_SHARED_SECRET=
# Optional: Railway supplies PORT. Use BOT_BRIDGE_PORT for a local bridge.
BOT_BRIDGE_PORT=

# Automatic project documents/photos: editable when handing over to a client.
GOOGLE_DRIVE_FOLDER_ID=1ua1Hqw28njRMX6YTB019Pg4JOG_4M_RC
# For a normal My Drive folder, use an authorized user's OAuth connection.
# Keep these secrets only in the hosting environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Alternatively use the existing service account with an accessible Shared Drive.
