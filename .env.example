# Create two bots with @BotFather. Never commit the real tokens.
LEADER_BOT_TOKEN=
GROUP_BOT_TOKEN=

# Google Cloud service-account credentials. Share the target spreadsheet with this email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the value on one line and use literal \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram numeric user ID for Parash/the founder. This account has global admin access.
FOUNDER_TELEGRAM_ID=

# Optional intelligence layer. Add a newly created OpenAI API key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Connect pending requests to the workflow web app.
WEB_APP_URL=
INTEGRATION_SHARED_SECRET=
# Optional: Railway supplies PORT. Use BOT_BRIDGE_PORT for a local bridge.
BOT_BRIDGE_PORT=

# Separate local staff workspace; these settings do not configure the production web app.
# First persistent start requires your own staff ID and a password of at least 12 characters.
WORKSPACE_FOUNDER_ID=
WORKSPACE_FOUNDER_NAME=Studio founder
WORKSPACE_FOUNDER_PASSWORD=
WORKSPACE_DB_PATH=data/workspace.sqlite
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=3002
# For HTTPS deployment, set the exact public origin and enable secure cookies.
WORKSPACE_ORIGIN=
WORKSPACE_SECURE_COOKIES=false
