# Create two bots with @BotFather. Never commit the real tokens.
LEADER_BOT_TOKEN=
GROUP_BOT_TOKEN=

# Google Cloud service-account credentials. Share the target spreadsheet with this email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the value on one line and use literal \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram numeric user ID for Parash/the founder. This account has global admin access.
FOUNDER_TELEGRAM_ID=

# Optional intelligence layer. Add a newly created OpenAI API key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
